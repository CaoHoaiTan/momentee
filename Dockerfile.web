# ─── Stage 1: deps ────────────────────────────────────────────────────────────
FROM node:20-alpine AS deps
WORKDIR /app

RUN corepack enable

COPY package.json yarn.lock .yarnrc.yml ./
COPY apps/server/package.json    apps/server/
COPY apps/web/package.json       apps/web/
COPY packages/shared/package.json packages/shared/

RUN yarn install --immutable

# ─── Stage 2: builder ─────────────────────────────────────────────────────────
FROM node:20-alpine AS builder
WORKDIR /app

RUN corepack enable

COPY package.json yarn.lock .yarnrc.yml turbo.json tsconfig.base.json ./
COPY apps/server/package.json    apps/server/
COPY apps/web/package.json       apps/web/
COPY packages/shared/package.json packages/shared/

# All deps hoisted to root by Yarn v4 nodeLinker: node-modules
COPY --from=deps /app/node_modules ./node_modules

# NEXT_PUBLIC_* variables are baked into the bundle at build time — must be passed as ARGs
ARG NEXT_PUBLIC_API_URL
ARG NEXT_PUBLIC_GRAPHQL_URL
ARG NEXT_PUBLIC_GOOGLE_CLIENT_ID
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    NEXT_PUBLIC_GRAPHQL_URL=$NEXT_PUBLIC_GRAPHQL_URL \
    NEXT_PUBLIC_GOOGLE_CLIENT_ID=$NEXT_PUBLIC_GOOGLE_CLIENT_ID \
    NEXT_TELEMETRY_DISABLED=1

COPY packages/shared/ packages/shared/
COPY apps/web/        apps/web/

RUN yarn workspace @momentee/shared build
RUN yarn workspace @momentee/web build

# ─── Stage 3: runner ──────────────────────────────────────────────────────────
FROM node:20-alpine AS runner
WORKDIR /app

ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1

RUN addgroup --system --gid 1001 nodejs \
 && adduser  --system --uid 1001 nextjs

# Standalone output is self-contained — copy the minimal server bundle
# With outputFileTracingRoot set to monorepo root, the server.js path is:
# apps/web/.next/standalone/apps/web/server.js
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/standalone/ ./

# Static assets are NOT included in standalone output — must be copied manually
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/.next/static/ ./apps/web/.next/static/
COPY --from=builder --chown=nextjs:nodejs /app/apps/web/public/        ./apps/web/public/

USER nextjs

EXPOSE 3000

ENV PORT=3000 \
    HOSTNAME=0.0.0.0

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD wget -qO- http://127.0.0.1:3000/ || exit 1

# Path reflects outputFileTracingRoot = monorepo root
CMD ["node", "apps/web/server.js"]
